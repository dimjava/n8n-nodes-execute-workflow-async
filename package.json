  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/ExecuteWorkflow/ExecuteWorkflow.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/jest": "^29.0.0",
    "@types/json-schema": "^7.0.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "jest-mock-extended": "^3.0.0",
    "prettier": "^3.0.0",
    "release-it": "^19.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "generate-schema": "^2.6.0",
    "json-schema": "^0.4.0",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
