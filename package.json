{
  "name": "n8n-nodes-execute-workflow",
  "version": "0.1.0",
  "description": "Custom Execute Workflow node for n8n — distinguishable from built-in, with configurable changes",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "execute-workflow",
    "sub-workflow"
  ],
  "author": {
    "name": "",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimjava/n8n-nodes-execute-workflow.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
